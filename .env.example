# ─── DocOps · configuração ──────────────────────────────────────────────────
# O install.sh gera o .env a partir deste arquivo com segredos aleatórios.

APP_NAME=DocOps
# IP e/ou nomes de acesso (separados por vírgula). Ex.: 10.10.1.218, 107.21.233.13
DOCOPS_HOST=10.10.1.218, 107.21.233.13
# Host/IP único usado no fallback de TLS quando o cliente acessa direto por IP sem SNI
DOCOPS_DEFAULT_SNI=107.21.233.13
TIMEZONE=America/Sao_Paulo

# Segredos (gerados pelo install.sh)
SECRET_KEY=troque-por-64-caracteres-aleatorios
POSTGRES_PASSWORD=troque-esta-senha

# Primeiro administrador (criado só se o banco estiver vazio; troca de senha obrigatória no 1º acesso)
ADMIN_EMAIL=admin@docops.local
ADMIN_PASSWORD=

# Sessão e login
SESSION_HOURS=12
COOKIE_SECURE=true
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
MIN_PASSWORD_LENGTH=12

# Coleta AWS
# No EC2: deixe as chaves vazias e use um instance profile que só pode sts:AssumeRole
# (e ajuste o hop limit do IMDSv2 para 2 — ver README).
# On-premises: informe um usuário IAM com permissão apenas de sts:AssumeRole nas roles DocVivaReadOnly.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
COLLECTOR_WORKERS=6
COLLECTOR_INNER_WORKERS=4
COLLECTOR_COST_EXPLORER=true
COLLECTION_TIMEOUT_MINUTES=120

# Backup diário do banco em disco local
BACKUP_DIR=./backups
BACKUP_HOUR=2
BACKUP_RETENTION_DAYS=14
