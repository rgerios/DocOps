# ─── DocOps HML · configuração ──────────────────────────────────────────────
# Copie para .env.hml (ou rode ./scripts/deploy.sh hml que gera automaticamente).

APP_NAME=DocOps HML
ENVIRONMENT=staging

# IP e/ou nomes de acesso (separados por vírgula). Ex.: 10.10.1.218, 107.21.233.13
DOCOPS_HOST=10.10.1.218, 107.21.233.13
DOCOPS_DEFAULT_SNI=107.21.233.13
HML_HTTP_PORT=8080
HML_HTTPS_PORT=8443
TIMEZONE=America/Sao_Paulo

# Segredos exclusivos de HML (gerados automaticamente pelo deploy.sh hml)
# Dica: se usar clone-prd-to-hml, mantenha o mesmo SECRET_KEY de PRD para descriptografar segredos Fernet clonados.
SECRET_KEY=troque-por-64-caracteres-aleatorios-hml
POSTGRES_PASSWORD=troque-esta-senha-hml

# Primeiro administrador de HML (criado só se o banco HML estiver vazio)
ADMIN_EMAIL=admin@docops.local
ADMIN_PASSWORD=

# Sessão e login
SESSION_HOURS=12
COOKIE_SECURE=true
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
MIN_PASSWORD_LENGTH=12

# Coleta AWS (opcional em HML)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
COLLECTOR_WORKERS=4
COLLECTOR_INNER_WORKERS=2
COLLECTOR_COST_EXPLORER=true
COLLECTION_TIMEOUT_MINUTES=120

# Backup diário isolado de HML
BACKUP_DIR=./backups-hml
BACKUP_HOUR=3
BACKUP_RETENTION_DAYS=7
